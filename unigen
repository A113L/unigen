    # ---------- One-click: encrypt the saved password list, then shred original ----------
    def encrypt_and_shred_password_file(self):
        if not CRYPTO_AVAILABLE:
            messagebox.showerror("Missing Dependency", "Install 'cryptography' to use this feature:\npip install cryptography")
            return

        path = self.last_saved_password_path
        if not path or not os.path.exists(path):
            if self.generated_passwords:
                self.save_passwords()
                path = self.last_saved_password_path
            if not path or not os.path.exists(path):
                messagebox.showwarning("No file", "Save the password list to a file first.")
                return

        pwd = simpledialog.askstring(
            "Encryption Passphrase",
            "Enter a passphrase (min 12 characters) to protect this password file:",
            show="•", parent=self.root
        )
        if not pwd or len(pwd) < MIN_PASSPHRASE_LEN:
            if pwd is not None:
                messagebox.showwarning("Too short", f"Passphrase must be at least {MIN_PASSPHRASE_LEN} characters.")
            return

        try:
            with open(path, "rb") as f:
                original_data = f.read()

            combined = self._encrypt_blob(pwd, original_data)

            enc_path = path + ".enc"
            # Audit fix: this used to write enc_path with a plain open()
            # and no fsync, then go on to permanently shred the plaintext
            # original once the readback verified. Without an fsync, the OS
            # is free to keep enc_path's bytes in its page cache
            # indefinitely — a crash or power loss after the shred but
            # before that cache is flushed could destroy both the
            # plaintext (already shredded) and the "encrypted" copy
            # (never actually made durable), losing the passwords for
            # good. Using the same atomic+fsync helper as save_passwords
            # closes that window: enc_path is only ever visible on disk
            # once it's completely and durably written.
            self._atomic_write_sensitive(enc_path, base64.b64encode(combined))

            # Verify: the encrypted file must decrypt back to the exact original bytes
            # before the plaintext is destroyed.
            with open(enc_path, "r", encoding="ascii") as f:
                check_b64 = f.read().strip()
            check_combined = base64.b64decode(check_b64)
            decrypted_back = self._decrypt_blob(pwd, check_combined)

            if decrypted_back == original_data:
                try:
                    result = self.shred_file(path)
                except OverwriteFailedError:
                    delete_anyway = messagebox.askyesno(
                        "Secure overwrite failed",
                        f"Encrypted to:\n{enc_path}\n\n"
                        "The original plaintext file's secure overwrite failed, so it was "
                        "left in place rather than deleted unverified.\n\n"
                        "Delete the original anyway WITHOUT a secure overwrite?"
                    )
                    if not delete_anyway:
                        messagebox.showinfo(
                            "Original kept",
                            f"Encrypted to:\n{enc_path}\n\nOriginal plaintext was NOT deleted:\n{path}"
                        )
                        self.last_saved_password_path = None
                        self.encrypt_shred_btn.config(state=tk.DISABLED)
                        return
                    result = self.shred_file(path, delete_on_overwrite_failure=True)

                if result == "fallback":
                    messagebox.showwarning(
                        "Encrypted, deletion not fully verified",
                        f"Encrypted to:\n{enc_path}\n\n"
                        "The original file was removed, but the secure multi-pass overwrite "
                        "could not be confirmed. If this matters, use a dedicated secure-erase tool."
                    )
                else:
                    messagebox.showinfo(
                        "Done",
                        f"Encrypted to:\n{enc_path}\n\nOriginal plaintext securely shredded:\n{path}\n\n{SSD_SHRED_CAVEAT}"
                    )
                self.last_saved_password_path = None
                self.encrypt_shred_btn.config(state=tk.DISABLED)
            else:
                messagebox.showerror(
                    "Verification failed",
                    "The encrypted file did not verify correctly \u2014 the original was NOT deleted."
                )
        except Exception as e:
            messagebox.showerror("Error", str(e))

    # ---------- Encryption (generic file protector) ----------
    def browse_encrypt_file(self):
        path = filedialog.askopenfilename(title="Select file to encrypt")
        if path:
            self.enc_file_path.set(path)
            self.current_values["enc_file"] = path
            self.check_enc_ready()

    def browse_decrypt_file(self):
        path = filedialog.askopenfilename(
            title="Select encrypted file",
            filetypes=[("Encrypted files", "*.enc"), ("All files", "*.*")]
        )
        if path:
            self.dec_file_path.set(path)
            self.current_values["dec_file"] = path
            self.check_dec_ready()

    def check_enc_ready(self):
        pwd_len = len(self.enc_pwd_var.get())
        ready = bool(self.enc_file_path.get() and MIN_PASSPHRASE_LEN <= pwd_len <= MAX_PASSPHRASE_LEN)
        self.enc_btn.config(state=tk.NORMAL if ready else tk.DISABLED)

    def check_dec_ready(self):
        pwd_len = len(self.dec_pwd_var.get())
        ready = bool(self.dec_file_path.get() and 0 < pwd_len <= MAX_PASSPHRASE_LEN)
        self.dec_btn.config(state=tk.NORMAL if ready else tk.DISABLED)

    def derive_key(self, password, salt, kdf_id=None):
        """Derive a 32-byte AES-256 key from a password + salt.

        kdf_id selects the KDF: KDF_ARGON2ID (default for new encryptions,
        when available) or KDF_PBKDF2 (used to decrypt files produced by
        older versions of this app, or as a fallback if Argon2id isn't
        available in the installed `cryptography` version).

        The password is converted to a bytearray and mlock()'d/zeroed
        best-effort around the derive() call (see secure_zero/try_mlock
        above) rather than left as an immutable Python str for longer than
        necessary."""
        if len(password) > MAX_PASSPHRASE_LEN:
            raise ValueError(
                f"Passphrase too long ({len(password)} chars). "
                f"Maximum is {MAX_PASSPHRASE_LEN} characters."
            )
        if kdf_id is None:
            kdf_id = KDF_ARGON2ID if ARGON2_AVAILABLE else KDF_PBKDF2

        # Audit fix: normalize to NFC before encoding. Without this, the
        # *same* passphrase typed on two different systems/input methods
        # (e.g. a precomposed "ó" vs. "o" + combining acute accent — both
        # look and sound identical) encodes to different UTF-8 bytes, so
        # they'd derive different keys and decryption would fail with a
        # confusing "wrong password" for a password the user is certain
        # they typed correctly. NFC is the form most text editors, browsers,
        # and OS input methods already normalize to by default, so this
        # matches the common case.
        #
        # Known trade-off: this does NOT retroactively fix files encrypted
        # by a version of this app from before this change using a
        # non-ASCII passphrase that happened to arrive in decomposed (NFD)
        # form — decrypting those may require entering the passphrase in
        # the exact form originally used. Purely-ASCII passphrases are
        # entirely unaffected (NFC/NFD are identical for ASCII).
        password = unicodedata.normalize("NFC", password)

        pwd_buf = bytearray(password.encode("utf-8"))
        locked = try_mlock(pwd_buf)
        try:
            if kdf_id == KDF_ARGON2ID:
                if not ARGON2_AVAILABLE:
                    raise ValueError(
                        "This file was encrypted with Argon2id, but the installed "
                        "'cryptography' package (< 42.0) doesn't support it. "
                        "Upgrade with: pip install -U cryptography"
                    )
                kdf = Argon2id(
                    salt=salt, length=32,
                    iterations=ARGON2_TIME_COST, lanes=ARGON2_LANES,
                    memory_cost=ARGON2_MEMORY_KIB,
                )
                return kdf.derive(bytes(pwd_buf))
            elif kdf_id == KDF_PBKDF2:
                kdf = PBKDF2HMAC(algorithm=hashes.SHA256(), length=32, salt=salt,
                                  iterations=PBKDF2_ITERATIONS)
                return kdf.derive(bytes(pwd_buf))
            else:
                raise ValueError(f"Unknown KDF id: {kdf_id}")
        finally:
            secure_zero(pwd_buf)
            if locked:
                try_munlock(pwd_buf)

    def _encrypt_blob(self, password, data):
        """Encrypt bytes with the current default KDF (Argon2id, falling
        back to PBKDF2 if Argon2id isn't available). Returns the full
        container: MAGIC + kdf_id + salt + iv + ciphertext.

        Known limitation: `AESGCM()` requires an immutable `bytes` key, so
        every call site here does `bytes(key)` on the mlock'd/zeroable
        bytearray right before use. That conversion allocates a second,
        immutable copy of the raw AES key that `secure_zero()` cannot wipe
        and that isn't covered by `try_mlock()`; it lives until CPython's
        GC reclaims it. This is a hard limitation of using pure-Python +
        the `cryptography` library's public API (which only accepts
        `bytes`) rather than something fixable in application code."""
        kdf_id = KDF_ARGON2ID if ARGON2_AVAILABLE else KDF_PBKDF2
        salt = os.urandom(16)
        iv = os.urandom(12)
        key = bytearray(self.derive_key(password, salt, kdf_id))
        locked = try_mlock(key)
        try:
            ct = AESGCM(bytes(key)).encrypt(iv, data, None)
        finally:
            secure_zero(key)
            if locked:
                try_munlock(key)
        return ENC_MAGIC + bytes([kdf_id]) + salt + iv + ct

    def _decrypt_blob(self, password, combined):
        """Decrypt a container produced by _encrypt_blob(), or a legacy
        (pre-Argon2) container with no magic header. Returns plaintext bytes."""
        if combined.startswith(ENC_MAGIC):
            header_len = len(ENC_MAGIC)
            kdf_id = combined[header_len]
            rest = combined[header_len + 1:]
            if len(rest) < 28:
                raise ValueError("Invalid file format")
            salt, iv, ct = rest[:16], rest[16:28], rest[28:]
        else:
            # Legacy format: no magic, no kdf_id byte -> always PBKDF2.
            if len(combined) < 28:
                raise ValueError("Invalid file format")
            kdf_id = KDF_PBKDF2
            salt, iv, ct = combined[:16], combined[16:28], combined[28:]

        key = bytearray(self.derive_key(password, salt, kdf_id))
        locked = try_mlock(key)
        try:
            return AESGCM(bytes(key)).decrypt(iv, ct, None)
        finally:
            secure_zero(key)
            if locked:
                try_munlock(key)

    # ---------- Streaming file encryption (audit item #3) ----------
    def _stream_encrypt_file(self, in_path, out_path, password, progress_cb=None):
        """Chunk-encrypt in_path -> out_path without loading the whole file
        into memory. Returns the sha256 hexdigest of the plaintext (computed
        on the fly) so it can be compared post-decrypt for verification
        instead of re-reading the (potentially huge) original into RAM.

        Writes to a `.tmp` sibling of out_path and os.replace()s it into
        place only once the whole ciphertext is flushed and fsynced, so a
        crash or power loss mid-write can never leave a truncated/corrupt
        file sitting at out_path — either the old out_path (if any) survives
        untouched, or the complete new file does. The parent directory is
        then fsynced too, since fsyncing the file alone doesn't guarantee
        the rename itself survives a crash."""
        if out_path is not None and os.path.abspath(in_path) == os.path.abspath(out_path):
            raise ValueError("Input and output paths must be different")
        kdf_id = KDF_ARGON2ID if ARGON2_AVAILABLE else KDF_PBKDF2
        salt = os.urandom(16)
        base_nonce = os.urandom(8)
        key = bytearray(self.derive_key(password, salt, kdf_id))
        locked = try_mlock(key)
        hasher = hashlib.sha256()
        total = os.path.getsize(in_path)
        done = 0
        tmp_path = out_path + ".tmp"
        try:
            aesgcm = AESGCM(bytes(key))
            with open(in_path, "rb") as fin, open(tmp_path, "wb") as fout:
                fout.write(STREAM_MAGIC)
                fout.write(bytes([kdf_id]))
                fout.write(salt)
                fout.write(base_nonce)
                counter = 0
                chunk = fin.read(STREAM_CHUNK_SIZE)
                while True:
                    # Hash the chunk we're about to encrypt — one call,
                    # right before it's used, rather than split across
                    # iterations — so the hash always covers exactly the
                    # bytes written and nothing more.
                    hasher.update(chunk)
                    next_chunk = fin.read(STREAM_CHUNK_SIZE)
                    is_final = (len(next_chunk) == 0)
                    nonce = base_nonce + counter.to_bytes(4, "big")
                    aad = counter.to_bytes(8, "big") + (b"\x01" if is_final else b"\x00")
                    ct = aesgcm.encrypt(nonce, chunk, aad)
                    fout.write(len(ct).to_bytes(4, "big"))
                    fout.write(ct)
                    done += len(chunk)
                    if progress_cb:
                        progress_cb(done, total)
                    counter += 1
                    if is_final:
                        break
                    chunk = next_chunk
                fout.flush()
                os.fsync(fout.fileno())
            os.replace(tmp_path, out_path)
            self._fsync_dir(out_path)
        except Exception:
            try:
                if os.path.exists(tmp_path):
                    os.remove(tmp_path)
            except Exception:
                pass
            raise
        finally:
            secure_zero(key)
            if locked:
                try_munlock(key)
        return hasher.hexdigest()

    def _stream_decrypt_file(self, in_path, out_path, password, progress_cb=None):
        """Chunk-decrypt in_path -> out_path (or hash-only if out_path is
        None) without loading the whole file into memory. Returns the
        sha256 hexdigest of the recovered plaintext."""
        if out_path is not None and os.path.abspath(in_path) == os.path.abspath(out_path):
            raise ValueError("Input and output paths must be different")
        tmp_path = (out_path + ".tmp") if out_path else None
        if tmp_path and os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass
        try:
            hexdigest = self._stream_decrypt_file_inner(in_path, tmp_path, password, progress_cb)
        except Exception:
            try:
                if tmp_path and os.path.exists(tmp_path):
                    os.remove(tmp_path)
            except Exception:
                pass
            raise
        if tmp_path:
            os.replace(tmp_path, out_path)
            self._fsync_dir(out_path)
        return hexdigest

    def _stream_decrypt_file_inner(self, in_path, tmp_path, password, progress_cb=None):
        with open(in_path, "rb") as fin:
            magic = fin.read(len(STREAM_MAGIC))
            if magic != STREAM_MAGIC:
                raise ValueError("Not a streamed-format encrypted file")
            kdf_id_bytes = fin.read(1)
            if not kdf_id_bytes:
                raise ValueError("Truncated encrypted file (missing KDF id)")
            kdf_id = kdf_id_bytes[0]
            salt = fin.read(16)
            base_nonce = fin.read(8)
            if len(salt) != 16 or len(base_nonce) != 8:
                raise ValueError("Invalid file format")

            key = bytearray(self.derive_key(password, salt, kdf_id))
            locked = try_mlock(key)
            hasher = hashlib.sha256()
            total = os.path.getsize(in_path)
            fout = self._open_tmp_owner_only(tmp_path) if tmp_path else None
            try:
                aesgcm = AESGCM(bytes(key))
                counter = 0
                while True:
                    len_bytes = fin.read(4)
                    if len(len_bytes) < 4:
                        raise ValueError("Truncated encrypted file")
                    ct_len = int.from_bytes(len_bytes, "big")
                    # ct_len is unauthenticated (it's plaintext metadata read
                    # before the AEAD tag is checked), so a malicious/corrupt
                    # file could claim an enormous length and force a huge
                    # allocation via fin.read(). Bound it to what a real
                    # chunk could ever be: one plaintext chunk plus the
                    # 16-byte GCM tag, with a little headroom.
                    if ct_len < 16 or ct_len > STREAM_CHUNK_SIZE + 64:
                        raise ValueError("Corrupted or malicious chunk length")
                    ct = fin.read(ct_len)
                    if len(ct) < ct_len:
                        raise ValueError("Truncated encrypted file")

                    # Lookahead: are we at the last chunk? Must match how
                    # is_final was decided during encryption (see above).
                    # next_len_bytes should be exactly 0 bytes (clean EOF —
                    # this was the final chunk) or exactly 4 bytes (a real
                    # next length header). Anything in between (1-3 bytes)
                    # means the file is truncated right at a chunk boundary;
                    # reject it explicitly here rather than seeking back and
                    # letting the next loop iteration's read/length checks
                    # eventually trip on the leftover partial bytes.
                    pos_before_next = fin.tell()
                    next_len_bytes = fin.read(4)
                    if len(next_len_bytes) not in (0, 4):
                        raise ValueError("Truncated encrypted file (partial chunk header)")
                    is_final = (len(next_len_bytes) == 0)
                    if not is_final:
                        fin.seek(pos_before_next)

                    nonce = base_nonce + counter.to_bytes(4, "big")
                    aad = counter.to_bytes(8, "big") + (b"\x01" if is_final else b"\x00")
                    plain = aesgcm.decrypt(nonce, ct, aad)
                    hasher.update(plain)
                    if fout:
                        fout.write(plain)
                    if progress_cb:
                        progress_cb(fin.tell(), total)
                    counter += 1
                    if is_final:
                        break
                if fout:
                    fout.flush()
                    os.fsync(fout.fileno())
            finally:
                secure_zero(key)
                if locked:
                    try_munlock(key)
                if fout:
                    fout.close()
        return hasher.hexdigest()

    def _shred_original_after_verified_encrypt(self, path):
        """Shred `path` (the just-encrypted original) after the caller has
        already verified the ciphertext decrypts back correctly. Returns
        (status_msg, status_fg, warning_shown) — never raises; on a secure-
        overwrite failure it asks the user whether to delete anyway."""
        try:
            result = self.shred_file(path)
        except OverwriteFailedError:
            delete_anyway = messagebox.askyesno(
                "Secure overwrite failed",
                "The original file's secure overwrite failed, so it was left "
                "in place rather than deleted unverified.\n\n"
                "Delete the original anyway WITHOUT a secure overwrite?"
            )
            if not delete_anyway:
                return ("Encrypted & verified. Original kept (secure overwrite failed).",
                        self.theme["warning"], False)
            result = self.shred_file(path, delete_on_overwrite_failure=True)

        if result == "fallback":
            messagebox.showwarning(
                "Deletion not fully verified",
                "The original file was removed, but the secure multi-pass overwrite "
                "could not be confirmed. Consider a dedicated secure-erase tool for "
                "highly sensitive data."
            )
            return ("Encrypted & verified. Original deleted (overwrite could not be confirmed).",
                    self.theme["warning"], True)
        return ("Encryption complete. Original securely shredded after verification. "
                "(Overwrite isn't guaranteed on SSDs/COW filesystems.)",
                self.theme["success"], False)

    def _shred_original_after_verified_encrypt_async(self, path, on_done):
        """Async counterpart to _shred_original_after_verified_encrypt: runs
        shred_file() on a background thread so shredding a large original
        file doesn't freeze the UI. Calls on_done(status_msg, status_fg,
        warning_shown) back on the main thread. The confirmation dialog on
        an overwrite failure still runs on the main thread (Tk dialogs must
        be shown from the main thread); only the blocking shred I/O is
        offloaded."""
        def do_shred():
            return self.shred_file(path)

        def on_success(result):
            self._finish_async_shred_result(result, on_done)

        def on_error(e):
            if not isinstance(e, OverwriteFailedError):
                on_done(f"Encrypted, but shred step failed: {e}", self.theme["warning"], False)
                return
            delete_anyway = messagebox.askyesno(
                "Secure overwrite failed",
                "The original file's secure overwrite failed, so it was left "
                "in place rather than deleted unverified.\n\n"
                "Delete the original anyway WITHOUT a secure overwrite?"
            )
            if not delete_anyway:
                on_done("Encrypted & verified. Original kept (secure overwrite failed).",
                        self.theme["warning"], False)
                return

            def do_shred2():
                return self.shred_file(path, delete_on_overwrite_failure=True)

            def on_success2(result2):
                self._finish_async_shred_result(result2, on_done)

            def on_error2(e2):
                on_done(f"Encrypted, but shred step failed: {e2}", self.theme["warning"], False)

            self._run_async(do_shred2, on_success2, on_error2)

        self._run_async(do_shred, on_success, on_error)

    def _finish_async_shred_result(self, result, on_done):
        if result == "fallback":
            messagebox.showwarning(
                "Deletion not fully verified",
                "The original file was removed, but the secure multi-pass overwrite "
                "could not be confirmed. Consider a dedicated secure-erase tool for "
                "highly sensitive data."
            )
            on_done("Encrypted & verified. Original deleted (overwrite could not be confirmed).",
                    self.theme["warning"], True)
        else:
            on_done("Encryption complete. Original securely shredded after verification. "
                    "(Overwrite isn't guaranteed on SSDs/COW filesystems.)",
                    self.theme["success"], False)

    def encrypt_file(self):
        path = self.enc_file_path.get()
        pwd = self.enc_pwd_var.get()
        if not path or len(pwd) < MIN_PASSPHRASE_LEN:
            return

        self.enc_status.config(text="Encrypting\u2026", fg=self.theme["accent"])
        self.root.update_idletasks()

        try:
            size = os.path.getsize(path)

            if size > STREAM_SIZE_THRESHOLD:
                self._encrypt_file_streaming(path, pwd)
                return

            with open(path, "rb") as f:
                data = f.read()

            combined = self._encrypt_blob(pwd, data)
            b64 = base64.b64encode(combined).decode("ascii")
            kdf_used = "Argon2id" if ARGON2_AVAILABLE else "PBKDF2-SHA256 (Argon2id unavailable \u2014 upgrade cryptography\u226542.0 for a stronger KDF)"

            self.last_encrypted_b64 = b64
            self.last_encrypted_filename = Path(path).name + ".enc"

            self.enc_result_text.config(state=tk.NORMAL)
            self.enc_result_text.delete(1.0, tk.END)
            # Only insert a short preview into the Tk text widget, never the
            # full Base64 blob — for a file just under STREAM_SIZE_THRESHOLD
            # that's ~25MB of text and can noticeably stall the UI on insert.
            # Copy/Save still operate on the full self.last_encrypted_b64.
            preview = b64[:1200] + "..." if len(b64) > 1200 else b64
            self.enc_result_text.insert(tk.END, preview + "\n")
            if len(b64) > 1200:
                self.enc_result_text.insert(tk.END, f"\n[Total length: {len(b64)} characters \u2014 use Copy or Save for full data]\n")
            self.enc_result_text.config(state=tk.DISABLED)

            self.enc_copy_btn.config(state=tk.NORMAL)
            self.enc_save_btn.config(state=tk.NORMAL)

            status_msg = f"Encryption complete (KDF: {kdf_used}). Use Copy or Save below."
            status_fg = self.theme["success"]

            if self.shred_after_enc_var.get():
                # Verify the ciphertext actually decrypts back before touching the original.
                try:
                    decrypted_back = self._decrypt_blob(pwd, combined)
                except Exception as e:
                    self.enc_status.config(text=f"Encrypted, but shred step failed: {e}",
                                            fg=self.theme["warning"])
                    return
                if decrypted_back != data:
                    self.enc_status.config(
                        text="Encrypted, but verification failed \u2014 original was NOT deleted.",
                        fg=self.theme["danger"])
                    return

                # Audit item #7: even for a small file, the multi-pass
                # overwrite in shred_file() is blocking disk I/O and can
                # briefly freeze the UI (worse on a slow/loaded disk right
                # at the streaming-threshold boundary). Run it off the main
                # thread like the streaming path already does, instead of
                # calling the synchronous _shred_original_after_verified_encrypt
                # here.
                if not self._busy_start("encrypt_flow_small_shred"):
                    return

                def on_shred_done(shred_msg, shred_fg, _warned):
                    self._busy_end("encrypt_flow_small_shred")
                    self.enc_status.config(text=shred_msg, fg=shred_fg)

                self.enc_status.config(text="Shredding original\u2026", fg=self.theme["accent"])
                self._shred_original_after_verified_encrypt_async(path, on_shred_done)
                return

            self.enc_status.config(text=status_msg, fg=status_fg)
        except Exception as e:
            self.enc_status.config(text=f"Error: {str(e)}", fg=self.theme["danger"])
            messagebox.showerror("Error", str(e))

    def _encrypt_file_streaming(self, path, pwd):
        """Large-file path (audit item #3): encrypts chunk-by-chunk straight
        to disk, so the plaintext is never fully materialized in RAM. No
        clipboard-copy preview is offered here (there's nothing sane to
        preview/copy for a multi-hundred-MB blob) — the output is written
        directly to a file the user picks.

        The actual encrypt/verify/shred work runs on a background thread
        (see _run_async) so a large file doesn't freeze the UI for the
        whole operation — this was flagged in review since KDF derivation,
        multi-GB streaming I/O, and a multi-pass shred of the original can
        together take a long time."""
        out_path = filedialog.asksaveasfilename(
            title="Save encrypted file (large file \u2014 streamed)",
            defaultextension=".enc",
            filetypes=[("Encrypted files", "*.enc"), ("All files", "*.*")],
            initialfile=Path(path).name + ".enc"
        )
        if not out_path:
            self.enc_status.config(text="Cancelled.", fg=self.theme["text_secondary"])
            return

        if not self._busy_start("encrypt_flow"):
            return  # an encrypt is already in flight; ignore the extra click

        self.last_encrypted_b64 = None
        self.last_encrypted_filename = None
        self.enc_copy_btn.config(state=tk.DISABLED)
        self.enc_save_btn.config(state=tk.DISABLED)
        self.enc_result_text.config(state=tk.NORMAL)
        self.enc_result_text.delete(1.0, tk.END)
        self.enc_result_text.insert(
            tk.END,
            f"[File is {os.path.getsize(path):,} bytes \u2014 encrypted via streaming, "
            f"too large to preview or copy. Written directly to:\n{out_path}]\n"
        )
        self.enc_result_text.config(state=tk.DISABLED)

        # Audit item #10: _stream_encrypt_file accepts progress_cb but it was
        # never wired up here, so a multi-GB file just showed a static
        # "Encrypting (streaming)..." label with no indication of progress.
        # progress_cb runs on the background thread, so it must not touch
        # Tk widgets directly — hop back to the main thread via root.after.
        last_pct = {"value": -1}

        def on_progress(done, total):
            if not total:
                return
            pct = int(done * 100 / total)
            if pct == last_pct["value"]:
                return
            last_pct["value"] = pct

            def update_label():
                try:
                    self.enc_status.config(text=f"Encrypting (streaming)\u2026 {pct}%")
                except Exception:
                    pass
            self.root.after(0, update_label)

        def do_encrypt():
            h = self._stream_encrypt_file(path, out_path, pwd, progress_cb=on_progress)
            self._restrict_file_permissions(out_path)
            return h

        def on_encrypt_error(e):
            self._busy_end("encrypt_flow")
            self.enc_status.config(text=f"Error: {str(e)}", fg=self.theme["danger"])
            messagebox.showerror("Error", str(e))

        def on_encrypted(original_hash):
            kdf_used = "Argon2id" if ARGON2_AVAILABLE else "PBKDF2-SHA256 (Argon2id unavailable \u2014 upgrade cryptography\u226542.0 for a stronger KDF)"
            status_msg = f"Encrypted (streamed, KDF: {kdf_used}). Saved: {out_path}"
            status_fg = self.theme["success"]

            if not self.shred_after_enc_var.get():
                self._busy_end("encrypt_flow")
                self.enc_status.config(text=status_msg, fg=status_fg)
                messagebox.showinfo("Done", status_msg)
                return

            def do_verify():
                # Memory-safe verification: stream-decrypt and hash rather
                # than loading the whole plaintext back into RAM.
                return self._stream_decrypt_file(out_path, None, pwd)

            def on_verify_error(e):
                self._busy_end("encrypt_flow")
                msg = f"Encrypted, but shred step failed: {e}"
                self.enc_status.config(text=msg, fg=self.theme["warning"])
                messagebox.showinfo("Done", msg)

            def on_verified(check_hash):
                if check_hash != original_hash:
                    self._busy_end("encrypt_flow")
                    msg = "Encrypted, but verification failed \u2014 original was NOT deleted."
                    self.enc_status.config(text=msg, fg=self.theme["danger"])
                    messagebox.showinfo("Done", msg)
                    return

                def on_shred_done(shred_msg, shred_fg, _warned):
                    self._busy_end("encrypt_flow")
                    final_msg = f"Encrypted (streamed) to {out_path}. {shred_msg}"
                    self.enc_status.config(text=final_msg, fg=shred_fg)
                    messagebox.showinfo("Done", final_msg)

                self.enc_status.config(text="Shredding original\u2026", fg=self.theme["accent"])
                self._shred_original_after_verified_encrypt_async(path, on_shred_done)

            self.enc_status.config(text="Verifying before shred\u2026", fg=self.theme["accent"])
            self._run_async(do_verify, on_verified, on_verify_error)

        self._run_async(
            do_encrypt, on_encrypted, on_encrypt_error,
            busy_widgets=[self.enc_btn],
            status_label=self.enc_status, busy_text="Encrypting (streaming)\u2026",
        )



    def copy_encrypted(self):
        if not self.last_encrypted_b64:
            return
        self.copy_to_clipboard(self.last_encrypted_b64, status_label=self.enc_status)

    def save_encrypted(self):
        if not self.last_encrypted_b64:
            return
        path = filedialog.asksaveasfilename(
            defaultextension=".enc",
            filetypes=[("Encrypted files", "*.enc"), ("All files", "*.*")],
            initialfile=self.last_encrypted_filename or "encrypted.enc"
        )
        if path:
            try:
                self._atomic_write_sensitive(path, self.last_encrypted_b64.encode("ascii"))
                self.enc_status.config(text=f"Saved: {path}", fg=self.theme["success"])
                messagebox.showinfo("Saved", f"Encrypted file saved.\n\n{path}")
            except Exception as e:
                messagebox.showerror("Error", str(e))

    def decrypt_file(self):
        path = self.dec_file_path.get()
        pwd = self.dec_pwd_var.get()
        if not path or not pwd:
            return

        if not path.lower().endswith(".enc"):
            if not messagebox.askyesno(
                "Unexpected extension",
                "This file doesn't end in .enc, so it may not be a file this app "
                "produced. Try to decrypt it anyway?"
            ):
                return

        self.dec_status.config(text="Decrypting\u2026", fg=self.theme["accent"])
        self.root.update_idletasks()

        try:
            with open(path, "rb") as f:
                head = f.read(len(STREAM_MAGIC))
            if head == STREAM_MAGIC:
                self._decrypt_file_streaming(path, pwd)
                return

            # M-2: guard against OOM on a large legacy (pre-streaming,
            # base64) .enc file. Only files written by the streaming path
            # (checked above via STREAM_MAGIC) are meant to be big; a
            # legacy-format file above the streaming threshold would try to
            # f.read() the whole base64 blob into RAM here, which can hang
            # or crash the UI on a multi-hundred-MB file.
            size = os.path.getsize(path)
            if size > STREAM_SIZE_THRESHOLD:
                msg = (
                    f"This file is {size:,} bytes and isn't in the streamed "
                    f"format this app expects for large files. Decrypting it "
                    f"would try to load the whole thing into memory. Refusing "
                    f"to avoid an out-of-memory crash."
                )
                self.dec_status.config(text="Error: legacy large file rejected", fg=self.theme["danger"])
                messagebox.showerror("File too large for this format", msg)
                return

            with open(path, "r", encoding="ascii") as f:
                b64 = f.read().strip()

            combined = base64.b64decode(b64)
            try:
                plain = self._decrypt_blob(pwd, combined)
            except ValueError as e:
                # Passphrase-length guard or missing-Argon2 guard from
                # derive_key() — distinct, user-actionable errors, not
                # "wrong password or corrupt file".
                self.dec_status.config(text=f"Error: {e}", fg=self.theme["danger"])
                messagebox.showerror("Error", str(e))
                return

            out_path = filedialog.asksaveasfilename(
                defaultextension="", filetypes=[("All files", "*.*")], initialfile=Path(path).stem
            )
            if out_path:
                # Atomic + owner-only-from-creation write (see
                # _atomic_write_sensitive), so a crash mid-write can't leave
                # a partial plaintext file at out_path, and the plaintext
                # is never briefly world/group-readable before permissions
                # are tightened.
                self._atomic_write_sensitive(out_path, plain)
                self.dec_status.config(text=f"Saved: {out_path}", fg=self.theme["success"])
                messagebox.showinfo("Success", f"File decrypted and saved.\n\n{out_path}")
        except Exception:
            self.dec_status.config(text="Error: wrong password or corrupt file", fg=self.theme["danger"])
            messagebox.showerror("Error", "Decryption failed. Wrong password or corrupt file.")

    def _decrypt_file_streaming(self, path, pwd):
        """Large-file counterpart to _encrypt_file_streaming: decrypts
        chunk-by-chunk straight to the chosen output file. Runs on a
        background thread (see _run_async) so decrypting a large file
        doesn't freeze the UI."""
        default_name = Path(path).stem if Path(path).suffix.lower() == ".enc" else Path(path).name
        out_path = filedialog.asksaveasfilename(
            title="Save decrypted file (large file \u2014 streamed)",
            defaultextension="", filetypes=[("All files", "*.*")], initialfile=default_name
        )
        if not out_path:
            self.dec_status.config(text="Cancelled.", fg=self.theme["text_secondary"])
            return

        if not self._busy_start("decrypt_flow"):
            return  # a decrypt is already in flight; ignore the extra click

        def do_decrypt():
            self._stream_decrypt_file(path, out_path, pwd)
            self._restrict_file_permissions(out_path)

        def on_success(_result):
            self._busy_end("decrypt_flow")
            self.dec_status.config(text=f"Saved: {out_path}", fg=self.theme["success"])
            messagebox.showinfo("Success", f"File decrypted and saved.\n\n{out_path}")

        def on_error(e):
            if isinstance(e, ValueError):
                self._busy_end("decrypt_flow")
                self.dec_status.config(text=f"Error: {e}", fg=self.theme["danger"])
                messagebox.showerror("Error", str(e))
                return
            # Includes AESGCM auth failures (wrong password / corrupted/
            # tampered chunk) — don't leave a partially-written output file
            # around implying success. A failed AEAD chunk means whatever
            # was written before it is genuine (if partial) plaintext, so
            # we try to shred it, not just delete it. This cleanup is also
            # done off the main thread to avoid re-blocking the UI on a
            # large partial file.
            def do_cleanup():
                leftover_warning = None
                try:
                    if os.path.exists(out_path):
                        try:
                            self.shred_file(out_path, delete_on_overwrite_failure=True)
                        except Exception:
                            try:
                                os.remove(out_path)
                            except Exception:
                                leftover_warning = out_path
                except Exception:
                    leftover_warning = out_path
                return leftover_warning

            def on_cleanup_done(leftover_warning):
                self._busy_end("decrypt_flow")
                self.dec_status.config(text="Error: wrong password or corrupt file", fg=self.theme["danger"])
                if leftover_warning:
                    messagebox.showerror(
                        "Decryption failed \u2014 partial file left on disk",
                        "Decryption failed (wrong password or corrupt file), and the "
                        "partially-decrypted output could not be removed or shredded.\n\n"
                        "It may contain sensitive plaintext. Please delete it manually:\n\n"
                        f"{leftover_warning}"
                    )
                else:
                    messagebox.showerror("Error", "Decryption failed. Wrong password or corrupt file.")

            def on_cleanup_error(_e):
                on_cleanup_done(out_path)

            self._run_async(do_cleanup, on_cleanup_done, on_cleanup_error)

        self._run_async(
            do_decrypt, on_success, on_error,
            busy_widgets=[self.dec_btn],
            status_label=self.dec_status, busy_text="Decrypting (streaming)\u2026",
        )



    # ---------- Manual shred ----------
    def browse_shred_file(self):
        path = filedialog.askopenfilename(title="Select file to shred")
        if path:
            self.shred_file_path.set(path)
            self.check_shred_ready()

    def check_shred_ready(self):
        ready = bool(self.shred_file_path.get())
        self.shred_btn.config(state=tk.NORMAL if ready else tk.DISABLED)

    # ---------- Background execution for long-running operations ----------
    # ---------- Double-trigger guard (audit M-3) ----------
    def _busy_start(self, key):
        """Atomically claim `key` for an in-flight long-running operation
        (encrypt/decrypt/shred). Returns False if that operation is already
        running, in which case the caller should just no-op — this is a
        stronger guard than disabling widgets alone, since it's checked
        synchronously on the main thread before any async work starts, and
        isn't subject to any lag between a click and a widget's disabled
        state actually taking visual effect."""
        if key in self._busy_ops:
            return False
        self._busy_ops.add(key)
        return True

    def _busy_end(self, key):
        self._busy_ops.discard(key)

    def _run_async(self, work, on_success, on_error=None, busy_widgets=None,
                    status_label=None, busy_text="Working\u2026"):
        """Run `work` (a zero-arg callable doing blocking I/O/crypto — shred,
        streaming encrypt/decrypt) on a background thread so it doesn't
        freeze the Tk main loop/UI for the duration.

        Tk is not thread-safe: widgets must only be touched from the main
        thread. So the worker thread does no UI work at all — it just calls
        `work()` and hands the result (or exception) back via
        `self.root.after(0, ...)`, which runs `on_success`/`on_error` on the
        main thread exactly like a normal event-driven callback.

        `busy_widgets` are disabled for the duration and restored to their
        prior state afterward, so the user can't double-trigger the same
        long operation (e.g. clicking Shred twice) while one is in flight."""
        busy_widgets = busy_widgets or []
        prev_states = {}
        for w in busy_widgets:
            try:
                prev_states[w] = w.cget("state")
                w.config(state=tk.DISABLED)
            except Exception:
                pass
        if status_label is not None:
            try:
                status_label.config(text=busy_text, fg=self.theme["accent"])
            except Exception:
                pass

        def restore():
            for w, state in prev_states.items():
                try:
                    w.config(state=state)
                except Exception:
                    pass

        def runner():
            try:
                result = work()
            except Exception as e:
                def done_err():
                    restore()
                    if on_error:
                        on_error(e)
                self.root.after(0, done_err)
            else:
                def done_ok():
                    restore()
                    on_success(result)
                self.root.after(0, done_ok)

        threading.Thread(target=runner, daemon=True).start()

    def shred_file_dialog(self):
        path = self.shred_file_path.get()
        if not path or not os.path.exists(path):
            return
        if not messagebox.askyesno("Confirm Shred", f"Permanently shred this file?\n\n{path}\n\nThis cannot be undone."):
            return
        if not self._busy_start("shred_manual"):
            return  # a shred is already in flight; ignore the extra click

        def do_shred():
            return self.shred_file(path)

        def on_success(result):
            self._busy_end("shred_manual")
            self._shred_dialog_finish(path, result)

        def on_error(e):
            if isinstance(e, OverwriteFailedError):
                self._shred_dialog_handle_overwrite_failure(path)
            else:
                self._busy_end("shred_manual")
                self.shred_status.config(text=f"Error: {str(e)}", fg=self.theme["danger"])
                messagebox.showerror("Error", str(e))

        self._run_async(
            do_shred, on_success, on_error,
            busy_widgets=[self.shred_btn], status_label=self.shred_status,
            busy_text="Shredding\u2026",
        )

    def _shred_dialog_handle_overwrite_failure(self, path):
        delete_anyway = messagebox.askyesno(
            "Secure overwrite failed",
            "The multi-pass overwrite could not be completed (e.g. read-only "
            "filesystem or permissions issue), so the file was left in place "
            "rather than deleted unverified.\n\n"
            "Delete it anyway WITHOUT a secure overwrite? The data may remain "
            "recoverable on disk if you choose this."
        )
        if not delete_anyway:
            self._busy_end("shred_manual")
            self.shred_status.config(
                text="Not deleted \u2014 secure overwrite failed.",
                fg=self.theme["danger"]
            )
            return

        def do_shred():
            return self.shred_file(path, delete_on_overwrite_failure=True)

        def on_success(result):
            self._busy_end("shred_manual")
            self._shred_dialog_finish(path, result)

        def on_error(e):
            self._busy_end("shred_manual")
            self.shred_status.config(text=f"Error: {str(e)}", fg=self.theme["danger"])
            messagebox.showerror("Error", str(e))

        self._run_async(
            do_shred, on_success, on_error,
            busy_widgets=[self.shred_btn], status_label=self.shred_status,
            busy_text="Shredding\u2026",
        )

    def _shred_dialog_finish(self, path, result):
        if result == "fallback":
            self.shred_status.config(
                text="Deleted, but secure overwrite could not be confirmed.",
                fg=self.theme["danger"]
            )
            messagebox.showwarning(
                "Deletion not fully verified",
                "The file was removed, but the secure multi-pass overwrite could not be "
                "confirmed. Consider a dedicated secure-erase tool for highly sensitive data."
            )
        else:
            self.shred_status.config(text="File securely shredded.", fg=self.theme["success"])
            self.shred_file_path.set("")
            self.check_shred_ready()
            messagebox.showinfo("Shred Complete", f"File has been securely deleted.\n\n{SSD_SHRED_CAVEAT}")

    def shred_file(self, path, passes=3, delete_on_overwrite_failure=False):
        """Securely shred a file: multi-pass random overwrite + zero pass,
        then delete. Returns 'secure' on success.

        If the overwrite step fails (read-only FS, permissions, I/O error),
        the file is left in place and OverwriteFailedError is raised instead
        of being deleted unverified-secure — deleting a file whose secure
        overwrite could not be confirmed is a silent downgrade to a plain
        `rm`, not a shred, and callers should decide (typically by asking
        the user) whether that's acceptable rather than have it happen
        implicitly. Pass delete_on_overwrite_failure=True to opt into a
        plain delete after a failed overwrite (returns 'fallback')."""
        if not os.path.exists(path):
            raise FileNotFoundError(f"File not found: {path}")
        if os.path.islink(path):
            # Refuse to shred through a symlink. Without this check,
            # open(path, "r+b") would silently overwrite whatever the link
            # points to (not the link itself), while os.remove() at the end
            # only deletes the link — the user believes they destroyed the
            # target file, but a symlink swapped in between the two calls
            # (or just present from the start) means a *different* file's
            # contents get shredded instead. Ask the caller to pass the
            # resolved path explicitly if that's really what they want.
            raise ValueError(
                f"Refusing to shred a symlink (would overwrite its target, not "
                f"the link itself): {path}\nResolved target: {os.path.realpath(path)}"
            )
        if os.path.isdir(path):
            raise IsADirectoryError(f"Cannot shred a directory: {path}")

        size = os.path.getsize(path)
        overwrite_ok = True
        overwrite_error = None

        if size > 0:
            try:
                chunk_size = 1024 * 1024
                # Open by fd rather than path, with O_NOFOLLOW where the
                # platform supports it, so a symlink swapped in for `path`
                # between the checks above and this open() (TOCTOU) causes
                # the open itself to fail instead of silently following the
                # link to some other file. os.open()+fdopen() also lets us
                # fstat the actual open file (not the path) to re-confirm
                # it's a regular file before writing to it.
                open_flags = os.O_RDWR
                o_nofollow = getattr(os, "O_NOFOLLOW", None)
                if o_nofollow is not None:
                    open_flags |= o_nofollow
                if hasattr(os, "O_BINARY"):
                    open_flags |= os.O_BINARY
                fd = os.open(path, open_flags)
                try:
                    st = os.fstat(fd)
                    if not stat.S_ISREG(st.st_mode):
                        raise ValueError(f"Refusing to shred a non-regular file: {path}")
                    with os.fdopen(fd, "r+b", closefd=True) as f:
                        fd = None  # ownership transferred to `f`
                        for _ in range(passes):
                            f.seek(0)
                            written = 0
                            while written < size:
                                to_write = min(chunk_size, size - written)
                                f.write(os.urandom(to_write))
                                written += to_write
                            f.flush()
                            try:
                                os.fsync(f.fileno())
                            except OSError:
                                pass
                        f.seek(0)
                        written = 0
                        while written < size:
                            to_write = min(chunk_size, size - written)
                            f.write(b'\x00' * to_write)
                            written += to_write
                        f.flush()
                        try:
                            os.fsync(f.fileno())
                        except OSError:
                            pass
                finally:
                    if fd is not None:
                        os.close(fd)
            except Exception as e:
                overwrite_ok = False
                overwrite_error = e

        if not overwrite_ok and not delete_on_overwrite_failure:
            # Do NOT delete: the file may still contain recoverable
            # plaintext/key material. Leave it for the caller to handle.
            raise OverwriteFailedError(
                f"Secure overwrite failed ({overwrite_error}); file left in place: {path}"
            )

        try:
            if sys.platform == "win32":
                os.chmod(path, stat.S_IWRITE)
            os.remove(path)
            self._fsync_dir(path)
        except Exception as e:
            action = "overwritten" if overwrite_ok else "overwrite failed"
            raise RuntimeError(f"File {action} but could not be removed: {e}")

        return "secure" if overwrite_ok else "fallback"

    # ---------- Clean shutdown ----------
    def on_close(self):
        """Best-effort cleanup when the window is closed: cancel any pending
        auto-clear timers, wipe passphrase/password fields still held in
        memory, and clear the clipboard so nothing sensitive lingers after
        the app exits. Never blocks exit even if a step fails.

        Audit item #2: encrypt/decrypt/shred run on daemon threads (see
        _run_async) so they can't block interpreter shutdown, but that also
        means closing mid-operation kills the worker outright — possibly
        leaving a half-written .tmp file or a partially-overwritten shred
        target. If any tracked op is still in self._busy_ops, ask for
        confirmation before proceeding so the user isn't surprised."""
        if getattr(self, "_busy_ops", None):
            proceed = messagebox.askyesno(
                "Operation in progress",
                "An encryption, decryption, or shred operation is still running.\n\n"
                "Closing now may leave an incomplete temporary file or an "
                "interrupted secure-delete. Close anyway?"
            )
            if not proceed:
                return

        for after_id_attr in ("_autoclear_after_id", "_enc_pwd_clear_after_id", "_dec_pwd_clear_after_id"):
            after_id = getattr(self, after_id_attr, None)
            if after_id:
                try:
                    self.root.after_cancel(after_id)
                except Exception:
                    pass
                setattr(self, after_id_attr, None)

        for var_attr in ("enc_pwd_var", "dec_pwd_var"):
            var = getattr(self, var_attr, None)
            if var is not None:
                try:
                    var.set("")
                except Exception:
                    pass

        self.current_values["enc_pwd"] = ""
        self.current_values["dec_pwd"] = ""
        self.last_encrypted_b64 = None

        try:
            self.clear_clipboard()
        except Exception:
            pass

        self.root.destroy()


