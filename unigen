# --- Best-effort secure memory handling (audit items #1, #2) -------------
# Pure Python cannot guarantee a secret is wiped from RAM: `str` is
# immutable (an old value can linger in freed memory until reused, and may
# already have been paged to swap), and CPython gives no portable way to
# mlock() an arbitrary object. What we *can* do, and do here:
#   - Do crypto-relevant secret handling on `bytearray` instead of `str`
#     wherever the value doesn't need to stay a Tk-displayable string, so it
#     can be explicitly overwritten with zeros the moment it's no longer
#     needed (secure_zero()).
#   - Best-effort mlock()/VirtualLock() that bytearray's backing buffer via
#     ctypes, so the OS is less likely to swap it out. This can silently
#     fail (missing privilege, platform without the call) — it is
#     defense-in-depth, not a guarantee, and every call site treats it that
#     way.
# The passphrase *entry field* itself must still be a Tk StringVar (Tkinter
# has no secure-string Entry backing), so the immutable-string exposure
# described in the audit is not eliminated for that field — it's reduced by
# converting to bytearray immediately at each point of use and zeroing that
# copy afterward, and by proactively clearing the StringVar (see
# _reset_pwd_autoclear_timer / on_close) rather than leaving it populated
# for the life of the app.

def secure_zero(buf):
    """Best-effort in-place zero of a mutable byte buffer. No-op / safe on
    anything that isn't a bytearray/memoryview-over-mutable-buffer."""
    if buf is None:
        return
    try:
        if isinstance(buf, bytearray):
            for i in range(len(buf)):
                buf[i] = 0
        elif isinstance(buf, memoryview) and not buf.readonly:
            buf[:] = b"\x00" * len(buf)
    except Exception:
        pass


def try_mlock(buf):
    """Best-effort: ask the OS to keep `buf` (a bytearray) out of swap.
    Returns True if the call reports success, False otherwise (including
    "not supported here") — callers must not depend on this succeeding.

    Caveat: `(ctypes.c_char * len(buf)).from_buffer(buf)` pins the
    bytearray's *current* backing buffer. If `buf` were ever resized
    (e.g. append/extend) while a pinning object from a prior call is still
    alive, ctypes can raise BufferError. Every call site in this file only
    ever creates a fixed-size bytearray and never resizes it afterward, so
    this doesn't currently trigger — but keep it that way, or re-derive the
    pinned view after any resize.
    """
    try:
        import ctypes
        addr = (ctypes.c_char * len(buf)).from_buffer(buf)
        ptr = ctypes.addressof(addr)
        if sys.platform == "win32":
            ctypes.windll.kernel32.VirtualLock.restype = ctypes.c_int
            return bool(ctypes.windll.kernel32.VirtualLock(ptr, len(buf)))
        else:
            libc = ctypes.CDLL(None)
            return libc.mlock(ctypes.c_void_p(ptr), ctypes.c_size_t(len(buf))) == 0
    except Exception:
        return False


def try_munlock(buf):
    try:
        import ctypes
        addr = (ctypes.c_char * len(buf)).from_buffer(buf)
        ptr = ctypes.addressof(addr)
        if sys.platform == "win32":
            ctypes.windll.kernel32.VirtualUnlock(ptr, len(buf))
        else:
            libc = ctypes.CDLL(None)
            libc.munlock(ctypes.c_void_p(ptr), ctypes.c_size_t(len(buf)))
    except Exception:
        pass

# --- .enc container format ---
# New files:    MAGIC(4) + KDF_ID(1) + salt(16) + iv(12) + ciphertext
# Legacy files (no MAGIC prefix): salt(16) + iv(12) + ciphertext, always PBKDF2.
# The magic bytes let decrypt_file() tell the two apart; a random 16-byte
# salt matching MAGIC by chance is negligible (2^-32).
ENC_MAGIC = b"UG2\x00"
KDF_PBKDF2 = 1
KDF_ARGON2ID = 2

# Argon2id parameters (OWASP-recommended baseline for interactive use):
# 64 MiB memory, 3 iterations, 4 parallel lanes.
ARGON2_MEMORY_KIB = 64 * 1024
ARGON2_TIME_COST = 3
ARGON2_LANES = 4

PBKDF2_ITERATIONS = 600_000

# --- Streaming file format (audit item #3) --------------------------------
# encrypt_file()/decrypt_file() historically read the whole file into RAM
# (f.read()), which OOMs or hangs the UI on very large files. Files above
# STREAM_SIZE_THRESHOLD now go through a chunked format instead: the file
# is processed STREAM_CHUNK_SIZE bytes at a time, each chunk independently
# authenticated with AES-GCM under its own nonce (base_nonce XOR a 4-byte
# big-endian counter) and an AAD that binds the chunk's position and
# whether it's the final chunk — so chunks can't be reordered, dropped, or
# have extra chunks appended without detection. Smaller files keep using
# the existing single-shot _encrypt_blob()/_decrypt_blob() container
# (base64 text), since that's what enables the clipboard copy/paste flow.
STREAM_MAGIC = b"UG3S"
STREAM_CHUNK_SIZE = 4 * 1024 * 1024      # 4 MiB plaintext per chunk
STREAM_SIZE_THRESHOLD = 20 * 1024 * 1024  # switch to streaming above 20 MiB


