# ---------- Self-source character set ----------
def load_self_source_chars():
    """Read this script's own source file and return its unique, printable,
    non-whitespace characters. Kept dynamic (rather than hard-coded) so the
    character set always matches whatever this file actually contains.

    Audit item #11: filtering on isprintable() alone is a blacklist (it
    happens to already exclude control/format characters, but "happens to"
    isn't the same guarantee as an explicit allowlist). This instead checks
    each character's Unicode general category against an explicit allowed
    set — letters, digits, punctuation, symbols — so a character added to
    the file later can't silently sneak into a generated password just
    because some future Python version classifies it as printable.

    Audit fix: category "M" (combining marks — Mn/Mc/Me) is deliberately
    NOT in the allowed set, even though it's part of "printable" Unicode.
    A combining mark has no width of its own; it visually attaches to
    whatever character precedes it (or renders as an isolated dotted
    circle if it's first). A password built from secrets.choice() over a
    pool that includes these could end up with marks stacked on a single
    base character, or a mark as the very first character with nothing to
    attach to — both unreadable and, worse, subject to Unicode canonical-
    equivalence surprises (the same visual password could normalize to
    different underlying text on different systems). Letters, digits,
    punctuation, and symbols all have their own display width and don't
    have this problem."""
    import unicodedata
    _ALLOWED_CATEGORY_PREFIXES = ("L", "N", "P", "S")  # Letter, Number,
    # Punctuation, Symbol — explicitly excludes C (control/format/
    # surrogate/private-use/unassigned), M (combining marks — see
    # docstring above), Z (separators/spaces), and any future category
    # not in this list.
    try:
        src_path = os.path.abspath(__file__)
        with open(src_path, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()
    except Exception:
        return ""
    seen = set()
    result = []
    for ch in content:
        if ch in ("\n", "\r", "\t", " "):
            continue
        if not ch.isprintable():
            continue
        if not unicodedata.category(ch).startswith(_ALLOWED_CATEGORY_PREFIXES):
            continue
        if ch not in seen:
            seen.add(ch)
            result.append(ch)
    return "".join(sorted(result))


