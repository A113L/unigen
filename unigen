    def on_len_change(self, *args):
        try:
            v = self.len_var.get()
            if v < 8:
                self.len_var.set(8)
            elif v > 128:
                self.len_var.set(128)
            self.current_values["length"] = self.len_var.get()
            if not self._rebuilding and getattr(self, "stat_cards", None):
                self.update_pool_stats()
        except Exception:
            pass

    def on_cnt_change(self, *args):
        try:
            v = self.cnt_var.get()
            if v < 1:
                self.cnt_var.set(1)
            elif v > 10000:
                self.cnt_var.set(10000)
            self.current_values["count"] = self.cnt_var.get()
        except Exception:
            pass

    def on_enc_pwd_change(self):
        self.current_values["enc_pwd"] = self.enc_pwd_var.get()
        self.check_enc_ready()
        self._reset_pwd_autoclear_timer("enc")
        self._update_pwd_strength_label()

    def _update_pwd_strength_label(self):
        pwd = self.enc_pwd_var.get()
        label = getattr(self, "enc_pwd_strength_label", None)
        if label is None:
            return
        if not pwd:
            label.config(text="")
            return
        bits = estimate_passphrase_entropy(pwd)
        rating, color_key = rate_entropy(bits)
        note = ""
        if any(not c.isascii() for c in pwd):
            # Audit item #8: the non-ASCII pool-size allowance (+300) is a
            # deliberately conservative floor, not a real estimate of e.g.
            # CJK entropy — make that visible rather than implying
            # precision the number doesn't have.
            note = "  (floor estimate \u2014 non-Latin text may be less random than this suggests)"
        elif len(pwd) < 12:
            note = "  (12+ characters recommended regardless of rating)"
        label.config(
            text=f"Estimated strength: {rating} (~{bits:.0f} bits){note}",
            fg=self.theme[color_key]
        )

    def on_dec_pwd_change(self):
        self.current_values["dec_pwd"] = self.dec_pwd_var.get()
        self.check_dec_ready()
        self._reset_pwd_autoclear_timer("dec")

    # ---------- Passphrase auto-clear ----------
    def _on_pwd_autoclear_toggle(self, which):
        """Called when the enc/dec 'clear passphrase after Ns' checkbox is toggled."""
        var = getattr(self, f"{which}_pwd_autoclear_var")
        self.current_values[f"{which}_pwd_autoclear"] = var.get()
        self._reset_pwd_autoclear_timer(which)

    def _reset_pwd_autoclear_timer(self, which):
        """(Re)start the inactivity countdown that clears the enc/dec passphrase
        field from memory. Called on every keystroke, so typing resets the clock;
        the field is only cleared after N seconds with no further changes."""
        attr = f"_{which}_pwd_clear_after_id"
        pending_id = getattr(self, attr, None)
        if pending_id:
            try:
                self.root.after_cancel(pending_id)
            except Exception:
                pass
            setattr(self, attr, None)

        enabled_var = getattr(self, f"{which}_pwd_autoclear_var", None)
        if enabled_var is None or not enabled_var.get():
            return

        pwd_var = getattr(self, f"{which}_pwd_var", None)
        if pwd_var is None or not pwd_var.get():
            return

        seconds = int(self.current_values.get("pwd_autoclear_seconds", 30))
        new_id = self.root.after(seconds * 1000, lambda: self._clear_pwd_field(which))
        setattr(self, attr, new_id)

    def _clear_pwd_field(self, which):
        """Wipe the enc/dec passphrase Entry's backing StringVar from memory."""
        setattr(self, f"_{which}_pwd_clear_after_id", None)
        pwd_var = getattr(self, f"{which}_pwd_var", None)
        if pwd_var is None or not pwd_var.get():
            return
        pwd_var.set("")
        status_label = getattr(self, f"{which}_status", None)
        if status_label is not None:
            try:
                status_label.config(
                    text=f"Passphrase cleared from memory after {self.current_values.get('pwd_autoclear_seconds', 30)}s of inactivity.",
                    fg=self.theme["text_secondary"]
                )
            except Exception:
                pass

    def get_active_pool(self):
        pool = ""
        for name, data in CHAR_SETS.items():
            if self.charset_vars[name].get():
                pool += data["chars"]
        seen = set()
        result = []
        for c in pool:
            if c not in seen:
                seen.add(c)
                result.append(c)
        return "".join(result)

    def update_pool_stats(self):
        try:
            cards = self.stat_cards
            if not cards or any(not lbl.winfo_exists() for lbl in cards.values()):
                return

            pool = self.get_active_pool()
            try:
                length = self.len_var.get()
            except Exception:
                length = 20
            pool_size = len(pool)

            cards["pool"].config(text=f"{pool_size:,}")
            entropy = calculate_entropy(length, pool_size)
            cards["entropy"].config(text=f"{entropy:.1f} bits")
            rating, color_key = rate_entropy(entropy)
            cards["strength"].config(text=rating, fg=self.theme[color_key])

            if pool_size == 0:
                self.warn_label.pack(anchor=tk.W, padx=16, pady=(0, 6))
                self.gen_btn.config(state=tk.DISABLED)
            else:
                self.warn_label.pack_forget()
                self.gen_btn.config(state=tk.NORMAL)
        except (tk.TclError, AttributeError, KeyError):
            # Widgets mid-teardown/rebuild (e.g. theme switch) — ignore, the
            # explicit update_pool_stats() call at the end of switch_theme()
            # will refresh everything once the new widgets exist.
            pass

    def generate_passwords(self):
        if self.gen_running:
            return
        pool = self.get_active_pool()
        try:
            length = self.len_var.get()
            count = self.cnt_var.get()
        except Exception:
            return
        if not pool or length <= 0 or count <= 0:
            return

        self.gen_running = True
        self.output_text.config(state=tk.NORMAL)
        self.output_text.delete(1.0, tk.END)

        if count > 100:
            self.progress.pack(fill=tk.X, pady=(8, 3))
            self.prog_label.pack(anchor=tk.W)
            self.root.update_idletasks()

        self.generated_passwords = []
        chunk = max(1, count // 100)
        lines = []

        for i in range(count):
            pwd = generate_password(length, pool)
            self.generated_passwords.append(pwd)
            lines.append(f"#{i + 1}: {pwd}")

            if count > 100 and ((i + 1) % chunk == 0 or i == count - 1):
                pct = int((i + 1) / count * 100)
                self.progress["value"] = pct
                self.prog_label.config(text=f"Generating\u2026 {pct}% ({i + 1:,}/{count:,})")
                self.root.update_idletasks()

        self.output_text.insert(tk.END, "\n".join(lines) + "\n")

        if count > 100:
            self.progress.pack_forget()
            self.prog_label.pack_forget()

        self.output_text.config(state=tk.DISABLED)
        self.copy_btn.config(state=tk.NORMAL)
        self.save_btn.config(state=tk.NORMAL)
        self.gen_running = False

    def copy_all_passwords(self):
        if not self.generated_passwords:
            return
        text = "\n".join(self.generated_passwords)
        self.copy_to_clipboard(text, status_label=self.gen_copy_status)

    @staticmethod
    def _fsync_dir(path):
        """Best-effort: fsync the parent directory of `path`. os.fsync() on
        the file itself only guarantees the file's *data* is durable;
        without also fsyncing the directory, the file's directory-entry
        (name -> inode mapping) can still be lost on a crash right after
        creation, leaving the file missing or the rename not applied. No-op
        on platforms/filesystems that don't support it (e.g. Windows) or on
        any other failure — this is defense-in-depth, not a guarantee."""
        try:
            dir_path = os.path.dirname(os.path.abspath(path)) or "."
            fd = os.open(dir_path, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        except Exception:
            pass

    @staticmethod
    def _open_tmp_owner_only(tmp_path):
        """Open (create) `tmp_path` for exclusive binary writing with owner
        -only permissions applied AT CREATION TIME, not after the fact.

        Audit finding: writing via plain open(path, "wb") and only calling
        _restrict_file_permissions() afterward leaves a window — however
        short — where the file exists on disk with the default umask
        permissions (often world/group-readable). For files that hold
        plaintext passwords or decrypted content, that window is a real
        local-multiuser information disclosure risk. On POSIX, os.open()
        with an explicit mode plus O_EXCL closes that window: the file
        never exists with any permissions other than 0o600. On Windows,
        POSIX modes are largely irrelevant (no umask), so we just create
        normally and rely on the existing icacls-based
        _restrict_file_permissions() call the caller makes afterward."""
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        if hasattr(os, "O_BINARY"):
            flags |= os.O_BINARY
        fd = os.open(tmp_path, flags, 0o600)
        return os.fdopen(fd, "wb")

    def _atomic_write_sensitive(self, path, data):
        """Write `data` (bytes) to `path` atomically and with owner-only
        permissions from the moment the file is created, then fsync the
        file and its parent directory. Used for any output that may
        contain plaintext (passwords, decrypted files) or that must never
        be left half-written (ciphertext containers).

        Pattern: create <path>.tmp with a mode that's restrictive from
        birth (see _open_tmp_owner_only) -> write -> flush -> fsync file ->
        os.replace() into place -> fsync directory. A crash at any point
        leaves either nothing, the old file untouched, or the complete new
        file — never a partial one, and never one with looser-than-owner
        permissions."""
        tmp_path = path + ".tmp"
        try:
            if os.path.exists(tmp_path):
                # Leftover from a previous crashed run — safe to remove
                # since nothing ever pointed to it as a finished file.
                os.remove(tmp_path)
        except Exception:
            pass
        try:
            with self._open_tmp_owner_only(tmp_path) as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
        except Exception:
            try:
                if os.path.exists(tmp_path):
                    os.remove(tmp_path)
            except Exception:
                pass
            raise
        os.replace(tmp_path, path)
        self._fsync_dir(path)
        self._restrict_file_permissions(path)

    @staticmethod
    def _restrict_file_permissions(path):
        """Best-effort: restrict a just-written sensitive file to owner-only
        read/write (chmod 600 on POSIX; ACL reset to the current user on
        Windows). Never raises — this is defense-in-depth on top of the
        content itself, not a hard requirement, so failures are swallowed."""
        try:
            if sys.platform == "win32":
                try:
                    # Prefer os.getlogin() (reads the session's actual logged
                    # -on user from the OS) over the USERNAME environment
                    # variable, which any process in the same session can
                    # override before launching this app (audit item #7:
                    # trusting a spoofable env var here could grant "Full
                    # control" to the wrong account name). Only fall back to
                    # the env var if getlogin() itself fails (e.g. running
                    # under some service contexts without a session).
                    try:
                        username = os.getlogin()
                    except OSError:
                        username = os.environ.get("USERNAME")
                    if not username:
                        return
                    result = subprocess.run(
                        ["icacls", str(path), "/inheritance:r", "/grant:r",
                         f"{username}:F"],
                        capture_output=True, timeout=3.0, check=False
                    )
                    # icacls is run with check=False deliberately (never
                    # raise on failure — this stays best-effort), but we no
                    # longer swallow a failed exit code completely silently:
                    # surfacing it costs nothing and helps diagnose "why is
                    # this file not actually restricted" reports.
                    if result.returncode != 0:
                        sys.stderr.write(
                            f"[unigen] warning: icacls could not restrict "
                            f"permissions on {path}: {result.stderr.decode(errors='replace').strip()}\n"
                        )
                except Exception:
                    pass
            else:
                os.chmod(path, stat.S_IRUSR | stat.S_IWUSR)
        except Exception:
            pass

