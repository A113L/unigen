def calculate_entropy(length, pool_size):
    if pool_size <= 1 or length <= 0:
        return 0.0
    return length * math.log2(pool_size)


def rate_entropy(bits):
    if bits < 40:
        return "Very weak", "danger"
    elif bits < 60:
        return "Weak", "danger"
    elif bits < 80:
        return "Moderate", "warning"
    elif bits < 110:
        return "Strong", "success"
    else:
        return "Very strong", "success"


# Audit fix: a small set of catastrophically common passwords/patterns that
# the character-class-pool model below would otherwise score as "Strong"
# purely because they happen to mix letters/digits/symbols (e.g.
# "Password1!" hits all four ASCII classes). This isn't meant to be a real
# breach-corpus check (that would need a bundled wordlist) — it's a cheap
# floor that catches the handful of choices real users reach for most
# often, so at least those don't show a falsely reassuring rating.
_COMMON_WEAK_PASSPHRASES = {
    "password", "password1", "password123", "12345678", "123456789",
    "1234567890", "qwerty123", "qwertyuiop", "letmein", "admin123",
    "welcome1", "iloveyou", "abc123456", "changeme", "trustno1",
    "passw0rd", "p@ssword", "p@ssw0rd", "correcthorsebatterystaple",
}


def _looks_like_low_diversity(passphrase):
    """True if the passphrase is dominated by repetition or a simple
    sequential run (e.g. "aaaaaaaa", "11111111", "abcdefgh", "12345678")
    — patterns the class-pool model can't see because they still use a
    "valid" character class, but that are trivial to guess."""
    n = len(passphrase)
    if n < 4:
        return False
    unique_ratio = len(set(passphrase)) / n
    if unique_ratio <= 0.35:
        return True
    # Longest run of strictly ascending or descending consecutive
    # codepoints (e.g. "abcd", "4321").
    longest_run = 1
    run = 1
    for i in range(1, n):
        delta = ord(passphrase[i]) - ord(passphrase[i - 1])
        if delta in (1, -1):
            run += 1
            longest_run = max(longest_run, run)
        else:
            run = 1
    return longest_run >= min(6, n)


def estimate_passphrase_entropy(passphrase):
    """Rough entropy estimate for a user-typed passphrase: infer the likely
    character pool from which classes are present (lower/upper/digit/symbol/
    other-unicode), then treat it as length * log2(pool) — the same
    conservative model used elsewhere in this app for generated passwords.

    This intentionally does NOT try to detect dictionary words or patterns
    in general (that needs a real wordlist/zxcvbn-style library, which this
    app doesn't bundle) — it remains a floor estimate, not a substitute for
    one. It DOES apply two cheap, high-value corrections so the number
    shown for an encryption passphrase isn't actively misleading:

      1. An exact/near-exact match against a short list of catastrophically
         common passwords is clamped to ~0 bits ("Very weak"), since the
         class-pool model alone would score e.g. "Password1!" as strong
         purely for touching four character classes.
      2. Low character diversity or an obvious sequential run (e.g.
         "aaaaaaaa", "abcdefgh") is penalized, since repeating/sequential
         characters from an "allowed" class don't carry that class's full
         entropy per character.

    Still not a substitute for a real strength library — just meant to stop
    the meter from being confidently wrong about the most common cases."""
    if not passphrase:
        return 0.0

    normalized = passphrase.strip().lower()
    if normalized in _COMMON_WEAK_PASSPHRASES:
        return 1.0  # effectively "Very weak" regardless of raw length/pool

    pool = 0
    if any(c.islower() for c in passphrase):
        pool += 26
    if any(c.isupper() for c in passphrase):
        pool += 26
    if any(c.isdigit() for c in passphrase):
        pool += 10
    if any((not c.isalnum()) and c.isascii() and c.isprintable() for c in passphrase):
        pool += 33
    if any(not c.isascii() for c in passphrase):
        pool += 300  # broad allowance for any non-ASCII/Unicode character used
    if pool == 0:
        pool = 1

    bits = calculate_entropy(len(passphrase), pool)

    if _looks_like_low_diversity(passphrase):
        # Fall back to counting entropy by actual unique characters used
        # rather than the theoretical class pool, which is a much closer
        # (and far more conservative) estimate for repetitive/sequential
        # input.
        unique_count = max(2, len(set(passphrase)))
        bits = min(bits, calculate_entropy(len(passphrase), unique_count))

    return bits


def generate_password(length, pool):
    if not pool or length <= 0:
        return ""
    return "".join(secrets.choice(pool) for _ in range(length))


